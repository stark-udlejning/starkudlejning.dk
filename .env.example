# Kopiér til .env ved lokal udvikling. .env er gitignored og må ALDRIG committes.
# I produktion sættes værdierne i Netlify env vars — aldrig i repoet (CLAUDE.md §5.2).

# ── Pseudonymisering ───────────────────────────────────────────────────────────
# Mindst 16 tegn. Genereres fx med: openssl rand -hex 32
#
# ADVARSEL: må aldrig roteres uden en migration, der genberegner alle hashes.
# Roteres den uden, mister alle brugere deres historik permanent (CLAUDE.md §4).
PSEUDONYM_SECRET=

# ── Supabase ───────────────────────────────────────────────────────────────────
# EU-region. Service role bruges kun serverside; browseren taler aldrig med Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Power Automate-adaptere ────────────────────────────────────────────────────
# Kendes kun af netlify/functions/lib/sendMail.js og lib/sharepoint.js.
PA_SENDMAIL_URL=
PA_SHARED_SECRET=

# ── Sessioner ──────────────────────────────────────────────────────────────────
# Signeringsnøgle til sessionscookien. Genereres som PSEUDONYM_SECRET.
SESSION_SECRET=
